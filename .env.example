# Copy to .env locally. Keep webhook credentials out of source control.
N8N_WF01_WEBHOOK_URL=
N8N_WF01_WEBHOOK_TOKEN=
N8N_WF03_WEBHOOK_URL=https://levantri.app.n8n.cloud/webhook/wf03/analyze
N8N_WF03_WEBHOOK_TOKEN=
N8N_WF04_WEBHOOK_URL=
N8N_WF04_WEBHOOK_TOKEN=

# Backend operator authentication. Generate the password hash with `npm run auth:hash-password` in backend.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_ROLE=operator
# Generate with: openssl rand -hex 32
SESSION_SECRET=
AUTH_ALLOWED_ORIGINS=http://localhost:5173,https://enrich-tile-shale.ngrok-free.dev
