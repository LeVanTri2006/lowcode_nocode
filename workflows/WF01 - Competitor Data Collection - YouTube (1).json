      "name": "03 - Split Competitors",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        496,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/channels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "contentDetails"
            },
            {
              "name": "id",
              "value": "={{$json.channelId}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "id": "16ce1d8c-3a95-4bb0-9782-53fa502e0e89",
      "name": "04 - Get YouTube Channel",
      "credentials": {
        "httpQueryAuth": {
          "id": "7ZkdfS2aYuLBsVfZ",
          "name": "Query Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const youtubeResults = $input.all();\nconst competitors = $('03 - Split Competitors').all();\n\nconst output = [];\n\nfor (let i = 0; i < youtubeResults.length; i++) {\n  const youtubeItem = youtubeResults[i].json;\n  const competitor = competitors[i]?.json;\n\n  if (!competitor) {\n    throw new Error(`Không tìm thấy competitor tương ứng ở index ${i}`);\n  }\n\n  const channel = youtubeItem.items?.[0];\n\n  if (!channel) {\n    throw new Error(\n      `YouTube không trả về channel cho competitor: ${competitor.name}`\n    );\n  }\n\n  const uploadsPlaylistId =\n    channel.contentDetails?.relatedPlaylists?.uploads;\n\n  if (!uploadsPlaylistId) {\n    throw new Error(\n      `Không tìm thấy uploads playlist của competitor: ${competitor.name}`\n    );\n  }\n\n  output.push({\n    json: {\n      competitor_id: competitor.id,\n      competitor_name: competitor.name,\n      platform: competitor.platform,\n      channel_id: competitor.channelId,\n      uploads_playlist_id: uploadsPlaylistId\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        0
      ],
      "id": "8b4a29ab-a6d7-4f41-9ab9-565feaa4d32a",
      "name": "05 - Extract Uploads Playlist"
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/playlistItems",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet,contentDetails"
            },
            {
              "name": "playlistId",
              "value": "={{$json.uploads_playlist_id}}"
            },
            {
              "name": "maxResults",
              "value": "5"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1168,
        0
      ],
      "id": "c8c68b3a-4dac-449a-bfe9-3f6017251644",
      "name": "06 - Get Latest Videos",
      "credentials": {
        "httpQueryAuth": {
          "id": "7ZkdfS2aYuLBsVfZ",
          "name": "Query Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const playlistResponses = $input.all();\nconst competitors = $('05 - Extract Uploads Playlist').all();\n\nconst output = [];\n\nfor (let i = 0; i < playlistResponses.length; i++) {\n  const playlist = playlistResponses[i].json;\n  const competitor = competitors[i]?.json;\n\n  if (!competitor) {\n    throw new Error(\n      `Không tìm thấy competitor tương ứng tại index ${i}`\n    );\n  }\n\n  const videos = playlist.items ?? [];\n\n  for (const video of videos) {\n    const videoId = video.contentDetails?.videoId;\n\n    if (!videoId) {\n      continue;\n    }\n\n    output.push({\n      json: {\n        competitor_id: competitor.competitor_id,\n        competitor_name: competitor.competitor_name,\n        platform: competitor.platform,\n        channel_id: competitor.channel_id,\n        uploads_playlist_id: competitor.uploads_playlist_id,\n\n        video_id: videoId,\n\n        title: video.snippet?.title ?? \"\",\n        description: video.snippet?.description ?? \"\",\n        published_at:\n          video.contentDetails?.videoPublishedAt ??\n          video.snippet?.publishedAt ??\n          null\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        0
      ],
      "id": "cbcb6717-b38e-4fbc-89d4-b42221a2ce78",
      "name": "07 - Extract Video IDs"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "6dc8c94c-a32b-4d87-af33-8de610d72d61",
              "leftValue": "={{$json.video_id}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1616,
        0
      ],
      "id": "d1a337cf-4ba3-4841-8479-885d2018052e",
      "name": "08 - Check Video IDs"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst videoIds = items\n  .map(item => item.json.video_id)\n  .filter(Boolean);\n\nif (videoIds.length === 0) {\n  throw new Error('Không có video_id hợp lệ');\n}\n\nreturn [\n  {\n    json: {\n      video_ids: videoIds.join(',')\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        0
      ],
      "id": "adf89b80-1aad-44e7-8b19-841139a3ef73",
      "name": "09 – Build Video ID List"
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/videos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet,statistics"
            },
            {
              "name": "id",
              "value": "={{$json.video_ids}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2064,
        0
      ],
      "id": "976751e2-2f48-40ff-baea-b09c2a822598",
      "name": "10- Get Video Details",
      "credentials": {
        "httpQueryAuth": {
          "id": "7ZkdfS2aYuLBsVfZ",
          "name": "Query Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all();\n\nif (responses.length === 0) {\n  throw new Error('Không có dữ liệu từ Node 10 - Get Video Details');\n}\n\n// Node 10 chỉ tạo 1 item chứa items[]\nconst videos = responses[0].json.items ?? [];\n\nif (videos.length === 0) {\n  throw new Error('YouTube không trả về video nào');\n}\n\n// Lấy mapping competitor từ Node 05\nconst competitors = $('05 - Extract Uploads Playlist').all();\n\nconst competitorMap = new Map(\n  competitors.map(item => [\n    item.json.channel_id,\n    {\n      competitor_id: item.json.competitor_id,\n      competitor_name: item.json.competitor_name,\n      platform: item.json.platform\n    }\n  ])\n);\n\nconst output = [];\n\nfor (const video of videos) {\n  const snippet = video.snippet ?? {};\n  const statistics = video.statistics ?? {};\n\n  const contentId = video.id;\n  const channelId = snippet.channelId;\n\n  if (!contentId) {\n    continue;\n  }\n\n  const competitor = competitorMap.get(channelId);\n\n  if (!competitor) {\n    throw new Error(\n      `Không tìm thấy competitor cho channelId: ${channelId}`\n    );\n  }\n\n  output.push({\n    json: {\n      competitor_id: competitor.competitor_id,\n      competitor_name: competitor.competitor_name,\n      platform: 'youtube',\n\n      content_id: contentId,\n\n      title: snippet.title ?? '',\n      description: snippet.description ?? '',\n\n      url: `https://www.youtube.com/watch?v=${contentId}`,\n\n      published_at: snippet.publishedAt ?? null,\n\n      views: Number(statistics.viewCount ?? 0),\n      likes: Number(statistics.likeCount ?? 0),\n      comments: Number(statistics.commentCount ?? 0),\n\n      shares: null,\n\n      captured_at: new Date().toISOString()\n    }\n  });\n}\n\nreturn output;"
      },
