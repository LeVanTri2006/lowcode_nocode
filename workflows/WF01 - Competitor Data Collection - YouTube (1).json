    },
    {
      "parameters": {
        "jsCode": "// Nhận đầu ra WF02 để xác nhận workflow con đã trả kết quả.\nconst wf02Results = $input.all();\n\nif (wf02Results.length === 0) {\n  throw new Error(\n    'WF02 không trả kết quả; không tiếp tục lưu metrics.'\n  );\n}\n\n// Lấy dữ liệu gốc từ YouTube, không phụ thuộc vào\n// nhánh nào của WF02 đã tạo đầu ra.\nconst sourceItems = $('11 - Normalize Videos').all();\n\nif (sourceItems.length === 0) {\n  throw new Error(\n    'Không có dữ liệu video gốc để chuẩn bị metrics.'\n  );\n}\n\nconst output = [];\n\nfor (const item of sourceItems) {\n  const source = item.json;\n\n  if (!source.content_id) {\n    continue;\n  }\n\n  output.push({\n    json: {\n      content_id: String(source.content_id),\n      views: Number(source.views ?? 0),\n      likes: Number(source.likes ?? 0),\n      comments: Number(source.comments ?? 0),\n\n      shares:\n        source.shares === null ||\n        source.shares === undefined\n          ? null\n          : Number(source.shares),\n\n      captured_at:\n        source.captured_at ?? new Date().toISOString()\n    }\n  });\n}\n\nif (output.length === 0) {\n  throw new Error(\n    'Không có video hợp lệ để lưu metrics.'\n  );\n}\n\nreturn output;"
      },
