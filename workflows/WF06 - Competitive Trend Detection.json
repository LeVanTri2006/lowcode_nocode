    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst analyses = response.data ?? [];\n\nreturn analyses\n  .filter(a => a.topic)\n  .map(a => ({\n    json: {\n      contentId: a.content_id,\n      topic: a.topic,\n      keywords: a.keywords,\n      category: a.category,\n      views: Number(a.views ?? a.viewCount ?? 0), // Bổ sung lượng xem\n      likes: Number(a.likes ?? a.likeCount ?? 0)  // Bổ sung lượng thích\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2176,
        -240
      ],
      "id": "eea7208c-10f4-4723-bb73-3e548aeca255",
      "name": "06 - Prepare Video Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "76434595-ee84-443d-9519-971ea7b458ee",
              "leftValue": "={{ $json.topic }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        2400,
        -240
      ],
      "id": "d46072a2-1c3a-451a-86b9-33b0ca1f57e2",
      "name": "07 - Validate Video Data"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    success: false,\n    workflow: 'WF06',\n    message: 'Không có video hợp lệ để phân tích xu hướng.',\n    processedAt: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        -144
      ],
      "id": "ee07312b-ef4b-4f44-ac86-3f70f9d093aa",
      "name": "08 - Handle Empty Video Data"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst allowedDirections = new Set(['rising', 'stable', 'falling']);\nconst seenNames = new Set();\nconst results = [];\n\nfor (const item of items) {\n  const raw = item.json.content;\n\n  if (typeof raw !== 'string' || !raw.trim()) {\n    continue;\n  }\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    // Bỏ qua kết quả JSON lỗi để các items hợp lệ vẫn được xử lý.\n    continue;\n  }\n\n  if (!Array.isArray(parsed.trends)) {\n    continue;\n  }\n\n  for (const trend of parsed.trends) {\n    if (!trend || typeof trend !== 'object') continue;\n\n    const name = String(trend.name ?? '').trim();\n    const reason = String(trend.reason ?? '').trim();\n    const evidence = String(trend.evidence ?? '').trim();\n    const score = Number(trend.score);\n    const growthRate = Number(trend.growth_rate);\n    const direction = trend.direction;\n\n    if (!name || !reason || !evidence) continue;\n    if (!Number.isFinite(score) || score < 0 || score > 100) continue;\n    if (!Number.isFinite(growthRate)) continue;\n    if (!allowedDirections.has(direction)) continue;\n\n    const key = name.toLocaleLowerCase('vi').replace(/\\s+/g, ' ');\n    if (seenNames.has(key)) continue;\n\n    seenNames.add(key);\n\n    results.push({\n      json: {\n        name,\n        score,\n        growth_rate: 0,\n        direction: 'stable',\n        reason: reason + ' Chưa có dữ liệu so sánh theo thời gian để xác minh chiều hướng tăng trưởng.',\n        evidence\n      }\n    });\n\n    if (results.length >= 5) break;\n  }\n\n  if (results.length >= 5) break;\n}\n\n// THÊM MỚI: Xử lý mảng rỗng để chống đứt luồng\nif (results.length === 0) {\n  return [{ json: { name: \"\" } }]; \n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2960,
        -320
      ],
      "id": "2952897a-1422-419b-a62c-fe344ddc18b3",
      "name": "10 - Validate and Parse AI Results"
