      "name": "04 - Prepare Competitor Data"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst videos = response.data ?? [];\n\nreturn videos\n  .filter(video => video.title && video.contentId)\n  .map(video => ({\n    json: {\n      competitorId: video.competitorId,\n      platform: video.platform,\n      contentId: video.contentId,\n      title: video.title,\n      description: (video.description ?? '').slice(0, 500),\n      publishedAt: video.publishedAt,\n      url: video.url,\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        80
      ],
      "id": "4f315f1b-bf9d-46b7-b3b3-90889a019722",
      "name": "06 - Prepare Video Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "76434595-ee84-443d-9519-971ea7b458ee",
              "leftValue": "={{ $json.title }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        1168,
        80
      ],
      "id": "de00cb67-8fde-4fb1-93e5-dd84512ac59e",
      "name": "07 - Validate Video Data"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    success: false,\n    workflow: 'WF06',\n    message: 'Không có video hợp lệ để phân tích xu hướng.',\n    processedAt: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        176
      ],
      "id": "5e480096-62c4-420f-ae0a-f2e99ec05ba2",
      "name": "08 - Handle Empty Video Data"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst allowedDirections = new Set(['rising', 'stable', 'falling']);\nconst seenNames = new Set();\nconst results = [];\n\nfor (const item of items) {\n  const raw = item.json.content;\n\n  if (typeof raw !== 'string' || !raw.trim()) {\n    continue;\n  }\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    // Bỏ qua kết quả JSON lỗi để các items hợp lệ vẫn được xử lý.\n    continue;\n  }\n\n  if (!Array.isArray(parsed.trends)) {\n    continue;\n  }\n\n  for (const trend of parsed.trends) {\n    if (!trend || typeof trend !== 'object') continue;\n\n    const name = String(trend.name ?? '').trim();\n    const reason = String(trend.reason ?? '').trim();\n    const evidence = String(trend.evidence ?? '').trim();\n    const score = Number(trend.score);\n    const growthRate = Number(trend.growth_rate);\n    const direction = trend.direction;\n\n    if (!name || !reason || !evidence) continue;\n    if (!Number.isFinite(score) || score < 0 || score > 100) continue;\n    if (!Number.isFinite(growthRate)) continue;\n    if (!allowedDirections.has(direction)) continue;\n\n    const key = name.toLocaleLowerCase('vi').replace(/\\s+/g, ' ');\n    if (seenNames.has(key)) continue;\n\n    seenNames.add(key);\n\n    results.push({\n      json: {\n        name,\n        score,\n        growth_rate: 0,\n        direction: 'stable',\n        reason: reason + ' Chưa có dữ liệu so sánh theo thời gian để xác minh chiều hướng tăng trưởng.',\n        evidence\n      }\n    });\n\n    if (results.length >= 5) break;\n  }\n\n  if (results.length >= 5) break;\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        0
      ],
      "id": "1ce9263a-6f64-4d0c-b233-d20ea18f5021",
      "name": "10 - Validate and Parse AI Results"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
