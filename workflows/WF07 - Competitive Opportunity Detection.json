      ],
      "id": "f149057b-290e-4f04-92ed-be1956ef4505",
      "name": "08 - Prepare AI Analysis Context"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "qwen2.5:3b",
          "mode": "list",
          "cachedResultName": "qwen2.5:3b"
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Bạn là chuyên gia phân tích cạnh tranh thị trường. Dựa CHỈ trên tập dữ liệu JSON bên dưới (gồm chủ đề xu hướng, tốc độ tăng trưởng, thể loại, views, likes và hiệu suất đối thủ), hãy phát hiện tối đa 3 cơ hội cạnh tranh giá trị nhất.\\n\\nQUY TẮC:\\n1. Không bịa số liệu hay tự suy diễn sự kiện ngoài dữ liệu.\\n2. Ưu tiên đánh giá cao các xu hướng và chủ đề có tổng lượng views/likes hoặc tốc độ tăng trưởng (growth_rate) vượt trội.\\n3. Nếu dữ liệu đầu vào không đủ hoặc hạn chế, bắt buộc phải nêu rõ hạn chế đó bên trong trường description.\\n4. Trả về DUY NHẤT một đối tượng JSON hợp lệ, tuyệt đối không dùng Markdown, không thêm lời giải thích nào ngoài JSON.\\n\\nCẤU TRÚC JSON BẮT BUỘC:\\n{\\n  \"opportunities\": [\\n    {\\n      \"title\": \"Tiêu đề cơ hội ngắn gọn, súc tích\",\\n      \"description\": \"Phân tích chi tiết dựa trên dữ liệu views, likes và xu hướng (nêu rõ hạn chế nếu có)\",\\n      \"potential_score\": 85,\\n      \"recommended_action\": \"Hành động đề xuất cụ thể, khả thi\"\\n    }\\n  ]\\n}\\n\\nLƯU Ý THÊM:\\n- potential_score phải là số nguyên từ 0 đến 100 thể hiện mức độ tiềm năng.\\n- Đảm bảo cú pháp JSON chuẩn xác, đóng mở ngoặc đầy đủ.\\n\\nDỮ LIỆU ĐẦU VÀO:\\n' + JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "num_predict": 1024,
          "format": "json"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        736,
