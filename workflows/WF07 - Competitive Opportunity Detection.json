      "name": "03 - Get AI Analyses"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nif (response.success !== true) {\n  throw new Error('API AI Analyses trả về success không hợp lệ');\n}\n\nif (!Array.isArray(response.data)) {\n  throw new Error('API AI Analyses không trả về mảng data');\n}\n\nconst valid = [];\nconst invalid = [];\n\nfor (const row of response.data) {\n  const topic = row.topic?.trim();\n  const summary = row.summary?.trim();\n  const social = row.socialContent;\n\n  if (!topic || !summary || !social?.title || !social?.competitor?.name) {\n    invalid.push({\n      id: row.id ?? null,\n      reason: 'Thiếu topic, summary, title hoặc tên đối thủ',\n    });\n    continue;\n  }\n\n  valid.push({\n    json: {\n      analysisId: row.id,\n      contentId: row.contentId,\n      topic,\n      category: row.category ?? null,\n      contentType: row.contentType ?? null,\n      sentiment: row.sentiment ?? null,\n      keywords: Array.isArray(row.keywords) ? row.keywords : [],\n      summary,\n      targetAudience: row.targetAudience ?? null,\n      keyMessage: row.keyMessage ?? null,\n      competitor: social.competitor.name,\n      competitorId: social.competitorId ?? null,\n      platform: social.platform ?? null,\n      title: social.title,\n      url: social.url ?? null,\n      publishedAt: social.publishedAt ?? null,\n    },\n  });\n}\n\nreturn valid.length > 0\n  ? valid\n  : [{\n      json: {\n        error: true,\n        message: 'Không có bản phân tích nào đạt yêu cầu',\n        invalidCount: invalid.length,\n        invalidRecords: invalid,\n      },\n    }];"
      },
