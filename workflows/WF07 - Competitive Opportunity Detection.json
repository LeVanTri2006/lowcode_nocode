    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst trends = Array.isArray(d.trends) ? d.trends : [];\nconst performance = Array.isArray(d.performance) ? d.performance : [];\nconst trendSummary = trends.map(t => ({\n  topic: String(t.topic ?? t.name ?? t.title ?? '').trim(),\n  growth_rate: Number(t.growth_rate ?? t.growthRate ?? 0),\n  category: String(t.category ?? '').trim(),\n  views: Number(t.views ?? 0),   // Bổ sung views từ WF06\n  likes: Number(t.likes ?? 0)\n}));\nconst performanceSummary = performance.map(p => ({\n  competitor: String(p.competitor_name ?? p.channel_name ?? p.name ?? '').trim(),\n  content_title: String(p.title ?? p.content_title ?? '').trim(),\n  views: Number(p.views ?? p.view_count ?? 0),\n  engagement_rate: Number(p.engagement_rate ?? p.engagementRate ?? 0),\n  category: String(p.category ?? '').trim()\n}));\nreturn [{json:{trends:trendSummary, performance:performanceSummary, input_checked_at:d.input_checked_at}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
