    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst trends = Array.isArray(d.trends) ? d.trends : [];\nconst performance = Array.isArray(d.performance) ? d.performance : [];\nconst trendSummary = trends.map(t => ({\n  topic: String(t.topic ?? t.name ?? t.title ?? '').trim(),\n  growth_rate: Number(t.growth_rate ?? t.growthRate ?? 0),\n  category: String(t.category ?? '').trim()\n}));\nconst performanceSummary = performance.map(p => ({\n  competitor: String(p.competitor_name ?? p.channel_name ?? p.name ?? '').trim(),\n  content_title: String(p.title ?? p.content_title ?? '').trim(),\n  views: Number(p.views ?? p.view_count ?? 0),\n  engagement_rate: Number(p.engagement_rate ?? p.engagementRate ?? 0),\n  category: String(p.category ?? '').trim()\n}));\nreturn [{json:{trends:trendSummary, performance:performanceSummary, input_checked_at:d.input_checked_at}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        912
      ],
      "id": "9ff4950d-6206-4e4d-93be-0e54aa1ae608",
      "name": "08 - Prepare AI Analysis Context"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "llama3.2:1b",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Bạn là chuyên gia phân tích cạnh tranh. Dựa CHỈ trên dữ liệu JSON bên dưới, hãy phát hiện tối đa 3 cơ hội cạnh tranh. Không bịa số liệu. Nếu dữ liệu không đủ, hãy nêu rõ hạn chế trong description. Trả DUY NHẤT JSON hợp lệ theo cấu trúc {\"opportunities\":[{\"title\":\"...\",\"description\":\"...\",\"potential_score\":0,\"recommended_action\":\"...\"}]}. potential_score phải là số nguyên từ 0 đến 100.\\nDỮ LIỆU:\\n' + JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "num_predict": 1024
        }
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        -672,
        912
      ],
      "id": "27c2f681-0457-46c2-af0c-73cdb5310d9c",
      "name": "09 - Ollama Opportunity Analysis",
      "credentials": {
        "ollamaApi": {
          "id": "XiC4iV2mHLf0nYr9",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = String(response.content ?? response.text ?? response.message?.content ?? '').trim();\nif (!raw) throw new Error('Ollama trả về nội dung rỗng.');\nconst clean = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/,'').trim();\nlet parsed;\ntry { parsed = JSON.parse(clean); } catch (e) { throw new Error('Ollama không trả về JSON hợp lệ: ' + e.message); }\nif (!Array.isArray(parsed.opportunities)) throw new Error('JSON AI thiếu mảng opportunities.');\nconst opportunities = parsed.opportunities.slice(0,3).map((o, index) => {\n  const score = Number(o.potential_score);\n  const errors = [];\n  if (!String(o.title ?? '').trim()) errors.push('Thiếu title');\n  if (!String(o.description ?? '').trim()) errors.push('Thiếu description');\n  if (!Number.isInteger(score) || score < 0 || score > 100) errors.push('potential_score phải là số nguyên 0–100');\n  if (!String(o.recommended_action ?? '').trim()) errors.push('Thiếu recommended_action');\n  return {json:{title:String(o.title ?? '').trim(), description:String(o.description ?? '').trim(), potential_score:score, recommended_action:String(o.recommended_action ?? '').trim(), is_valid:errors.length===0, validation_errors:errors, rank:index+1}};\n});\nif (opportunities.length === 0) return [{json:{no_opportunities:true, message:'AI không phát hiện cơ hội nào từ dữ liệu đầu vào.'}}];\nreturn opportunities;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        912
      ],
      "id": "7e9a5185-2628-4a24-a972-33909767fbab",
