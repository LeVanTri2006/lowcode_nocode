    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = String(response.content ?? response.text ?? response.message?.content ?? '').trim();\nif (!raw) throw new Error('Ollama trả về nội dung rỗng.');\nconst clean = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/,'').trim();\nlet parsed;\ntry { parsed = JSON.parse(clean); } catch (e) { throw new Error('Ollama không trả về JSON hợp lệ: ' + e.message); }\nif (!Array.isArray(parsed.opportunities)) throw new Error('JSON AI thiếu mảng opportunities.');\nconst opportunities = parsed.opportunities.slice(0,3).map((o, index) => {\n  const score = Number(o.potential_score);\n  const errors = [];\n  if (!String(o.title ?? '').trim()) errors.push('Thiếu title');\n  if (!String(o.description ?? '').trim()) errors.push('Thiếu description');\n  if (!Number.isInteger(score) || score < 0 || score > 100) errors.push('potential_score phải là số nguyên 0–100');\n  if (!String(o.recommended_action ?? '').trim()) errors.push('Thiếu recommended_action');\n  return {json:{title:String(o.title ?? '').trim(), description:String(o.description ?? '').trim(), potential_score:score, recommended_action:String(o.recommended_action ?? '').trim(), is_valid:errors.length===0, validation_errors:errors, rank:index+1}};\n});\nif (opportunities.length === 0) return [{json:{no_opportunities:true, message:'AI không phát hiện cơ hội nào từ dữ liệu đầu vào.'}}];\nreturn opportunities;"
      },
