      ],
      "id": "71869605-4056-40f6-b0b2-d5c29e5bc9f8",
      "name": "09 - Ollama Opportunity Analysis",
      "credentials": {
        "ollamaApi": {
          "id": "l83Vzrt95BoSfMCw",
          "name": "Ollama account"
        }
      }
