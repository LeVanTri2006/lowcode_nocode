    {
      "parameters": {
        "jsCode": "const alerts = Array.isArray($json.monitoring_alerts) ? $json.monitoring_alerts : [];\nconst contents = Array.isArray($json.social_contents) ? $json.social_contents : [];\n\nconst limitedAlerts = alerts.slice(0, 20);\nconst limitedContents = contents.slice(0, 20);\n\nconst context = {\n  analyzed_at: $json.analyzed_at,\n  monitoring_alerts: limitedAlerts,\n  competitor_contents: limitedContents\n};\n\nconst prompt = `Bạn là chuyên gia phân tích rủi ro cạnh tranh. Chỉ sử dụng dữ liệu đầu vào, không tự bịa dữ kiện.\\n\\nDỮ LIỆU:\\n${JSON.stringify(context)}\\n\\nNhiệm vụ: phát hiện các rủi ro cạnh tranh có bằng chứng từ dữ liệu. Nếu dữ liệu không đủ để xác định rủi ro, trả về risks là mảng rỗng.\\n\\nChỉ trả về JSON hợp lệ, không Markdown, theo cấu trúc:\\n{\\\"risks\\\":[{\\\"risk_title\\\":\\\"Tên rủi ro\\\",\\\"severity\\\":\\\"Low|Medium|High|Critical\\\",\\\"impact_analysis\\\":\\\"Phân tích tác động dựa trên dữ liệu\\\",\\\"mitigation_strategy\\\":\\\"Biện pháp giảm thiểu\\\",\\\"evidence\\\":\\\"Dữ liệu cụ thể làm căn cứ\\\"}]}\\n\\nKhông tạo rủi ro không có căn cứ. Tối đa 10 rủi ro. Mỗi trường phải là chuỗi không rỗng.`;\n\nreturn [{ json: { prompt, analyzed_at: $json.analyzed_at, source_alert_count: alerts.length, source_content_count: contents.length } }];"
      },
      "id": "586a3184-379f-4499-b435-9f7e4adaf2c6",
      "name": "08 - Prepare AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1376,
        1280
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "llama3.2:1b",
          "mode": "list",
          "cachedResultName": "llama3.2:1b"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $('08 - Prepare AI Context').first().json.prompt }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "num_predict": 1024
        }
      },
      "id": "8e34b7df-29b2-4445-b043-77ba9771c04d",
      "name": "09 - Analyze Risks with Ollama",
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        -1136,
        1280
      ],
      "credentials": {
        "ollamaApi": {
          "id": "XiC4iV2mHLf0nYr9",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst raw = result.content ?? result.text ?? result.response ?? result.output ?? '';\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  return [{ json: { is_valid: false, error: 'Ollama returned an empty response', risks: [] } }];\n}\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  const start = cleaned.indexOf('{');\n  const end = cleaned.lastIndexOf('}');\n  if (start < 0 || end < start) throw new Error('JSON object not found');\n  parsed = JSON.parse(cleaned.slice(start, end + 1));\n} catch (error) {\n  return [{ json: { is_valid: false, error: `Could not parse Ollama JSON: ${error.message}`, risks: [] } }];\n}\n\nif (!parsed || !Array.isArray(parsed.risks)) {\n  return [{ json: { is_valid: false, error: 'AI output must contain a risks array', risks: [] } }];\n}\n\nconst allowedSeverity = ['Low', 'Medium', 'High', 'Critical'];\nconst risks = parsed.risks.map((risk) => ({\n  risk_title: typeof risk.risk_title === 'string' ? risk.risk_title.trim() : '',\n  severity: typeof risk.severity === 'string' ? risk.severity.trim() : '',\n  impact_analysis: typeof risk.impact_analysis === 'string' ? risk.impact_analysis.trim() : '',\n  mitigation_strategy: typeof risk.mitigation_strategy === 'string' ? risk.mitigation_strategy.trim() : '',\n  evidence: typeof risk.evidence === 'string' ? risk.evidence.trim() : ''\n}));\n\nconst invalidRisks = risks.filter((risk) =>\n  !risk.risk_title ||\n  !allowedSeverity.includes(risk.severity) ||\n  !risk.impact_analysis ||\n  !risk.mitigation_strategy ||\n  !risk.evidence\n);\n\nreturn [{\n  json: {\n    is_valid: invalidRisks.length === 0,\n    error: invalidRisks.length ? 'One or more risks have missing fields or invalid severity' : null,\n    analyzed_at: $('08 - Prepare AI Context').first().json.analyzed_at,\n    source_alert_count: $('08 - Prepare AI Context').first().json.source_alert_count,\n    source_content_count: $('08 - Prepare AI Context').first().json.source_content_count,\n    risks\n  }\n}];"
      },
