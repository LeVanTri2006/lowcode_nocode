    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst raw = result.content ?? result.text ?? result.response ?? result.output ?? '';\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  return [{ json: { is_valid: false, error: 'Ollama trả về nội dung rỗng', risks: [] } }];\n}\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '').trim();\n  const start = cleaned.indexOf('{');\n  const end = cleaned.lastIndexOf('}');\n  if (start < 0 || end < start) throw new Error('Không tìm thấy JSON');\n  parsed = JSON.parse(cleaned.slice(start, end + 1));\n} catch (error) {\n  return [{ json: { is_valid: false, error: `Lỗi parse JSON: ${error.message}`, risks: [] } }];\n}\n\nif (!parsed || !Array.isArray(parsed.risks) || parsed.risks.length === 0) {\n  return [{ json: { is_valid: false, error: 'Không có rủi ro trong JSON', risks: [] } }];\n}\n\nconst severityScoreMap = { low: 25, medium: 50, high: 75, critical: 90 };\nconst ctx = $('08 - Prepare AI Context').first().json;\n\nconst validRisks = parsed.risks\n  .map((risk, index) => {\n    const title = String(risk.risk_title ?? risk.title ?? '').trim();\n    const rawSev = String(risk.severity ?? 'Medium').trim();\n    const sevLower = rawSev.toLowerCase();\n    const score = Number(risk.score) || severityScoreMap[sevLower] || 50;\n    const impact = String(risk.impact_analysis ?? risk.reason ?? risk.description ?? '').trim();\n    const mitigation = String(risk.mitigation_strategy ?? risk.recommended_action ?? '').trim();\n    const evidenceText = String(risk.evidence ?? '').trim();\n\n    return {\n      is_valid: Boolean(title && impact),\n      // Bộ trường chuẩn đồng bộ với WF06, WF07 và Frontend WF08\n      title: title,\n      name: title,\n      risk_title: title,\n      severity: sevLower,\n      level: sevLower,\n      priority: sevLower,\n      score: score,\n      risk_score: score,\n      reason: impact,\n      description: impact,\n      impact_analysis: impact,\n      mitigation: mitigation,\n      mitigation_strategy: mitigation,\n      recommended_action: mitigation,\n      evidence: {\n        description: impact,\n        impact_analysis: impact,\n        mitigation_strategy: mitigation,\n        recommended_action: mitigation,\n        raw_evidence: evidenceText,\n        score: score,\n        rank: index + 1\n      },\n      analyzed_at: ctx.analyzed_at,\n      source_alert_count: ctx.source_alert_count,\n      source_content_count: ctx.source_content_count\n    };\n  })\n  .filter(r => r.is_valid);\n\nif (validRisks.length === 0) {\n  return [{ json: { is_valid: false, error: 'Rủi ro thiếu tiêu đề hoặc phân tích', risks: [] } }];\n}\n\n// Xuất từng rủi ro thành 1 item riêng giống hệt Node 10 của WF07\nreturn validRisks.map(r => ({ json: r }));"
      },
