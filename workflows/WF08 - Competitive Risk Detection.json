      "id": "8b2c90af-4a90-429e-b5cd-d1bac200d9a0",
      "name": "09 - Analyze Risks with Ollama",
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        2752,
        304
      ],
      "credentials": {
        "ollamaApi": {
          "id": "l83Vzrt95BoSfMCw",
          "name": "Ollama account"
