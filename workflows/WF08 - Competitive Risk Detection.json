    {
      "parameters": {
        "jsCode": "const alerts = Array.isArray($json.monitoring_alerts) ? $json.monitoring_alerts : [];\nconst contents = Array.isArray($json.social_contents) ? $json.social_contents : [];\n\nconst limitedAlerts = alerts.slice(0, 10).map(a => ({\n  alertType: String(a.alertType ?? a.type ?? '').trim(),\n  message: String(a.message ?? '').trim().slice(0, 100),\n  platform: String(a.platform ?? '').trim()\n}));\n\nconst limitedContents = contents.slice(0, 10).map(c => ({\n  title: String(c.title ?? '').trim().slice(0, 100),\n  description: String(c.description ?? '').trim().slice(0, 150),\n  platform: String(c.platform ?? '').trim()\n}));\n\nconst context = {\n  analyzed_at: $json.analyzed_at,\n  monitoring_alerts: limitedAlerts,\n  competitor_contents: limitedContents\n};\n\nconst prompt = `Bạn là chuyên gia phân tích rủi ro cạnh tranh. Chỉ sử dụng dữ liệu đầu vào, không tự bịa dữ kiện.\n\nDỮ LIỆU:\n${JSON.stringify(context)}\n\nNhiệm vụ: Phát hiện các rủi ro cạnh tranh có bằng chứng từ dữ liệu. Nếu không đủ dữ liệu, trả về mảng risks rỗng.\n\nQUY TẮC BẮT BUỘC ĐỂ TRÁNH LỖI JSON:\n1. Chỉ trả về DUY NHẤT một đối tượng JSON hợp lệ, tuyệt đối không bọc kết quả bằng các khối Markdown.\n2. Không được để lộ dấu nháy kép bên trong các giá trị chuỗi (text), hãy dùng dấu nháy đơn nếu cần.\n3. Đảm bảo tất cả các dấu ngoặc và dấu phẩy được đóng mở chính xác.\n\nCẤU TRÚC JSON:\n{\n  \"risks\": [\n    {\n      \"risk_title\": \"Tên rủi ro ngắn gọn\",\n      \"severity\": \"Low\",\n      \"impact_analysis\": \"Phân tích tác động\",\n      \"mitigation_strategy\": \"Biện pháp giảm thiểu\",\n      \"evidence\": \"Dữ liệu làm căn cứ\"\n    }\n  ]\n}`;\n\nreturn [{ json: { prompt, analyzed_at: $json.analyzed_at, source_alert_count: alerts.length, source_content_count: contents.length } }];"
      },
      "id": "6794bc10-9532-41ba-8835-33eb69f1e02c",
      "name": "08 - Prepare AI Context",
