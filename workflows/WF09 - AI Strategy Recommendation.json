      "id": "3f5b6e93-321a-402f-ae4d-40fcb168bc15",
      "name": "09 - Parse AI Strategy Response"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const d = item.json;\n  const errors = [];\n  if (d.parse_ok !== true) errors.push(d.parse_error || 'Không phân tích được JSON từ AI.');\n  if (typeof d.strategy_title !== 'string' || !d.strategy_title.trim()) errors.push('Thiếu strategy_title.');\n  if (typeof d.objective !== 'string' || !d.objective.trim()) errors.push('Thiếu objective.');\n  if (!Array.isArray(d.action_steps) || d.action_steps.length < 3 || !d.action_steps.every(s => typeof s === 'string' && s.trim())) errors.push('action_steps phải là mảng có ít nhất 3 bước dạng văn bản.');\n  if (typeof d.expected_outcome !== 'string' || !d.expected_outcome.trim()) errors.push('Thiếu expected_outcome.');\n  if (d.supporting_evidence !== undefined && !Array.isArray(d.supporting_evidence)) errors.push('supporting_evidence phải là mảng.');\n  if (d.limitations !== undefined && !Array.isArray(d.limitations)) errors.push('limitations phải là mảng.');\n\n  return { json: { ...d, is_valid: errors.length === 0, validation_errors: errors } };\n});"
      },
