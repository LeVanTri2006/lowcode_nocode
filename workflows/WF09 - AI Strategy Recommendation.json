    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst raw = result.content ?? result.text ?? result.response ?? result.output ?? result.message?.content ?? result.choices?.[0]?.message?.content;\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  return [{ json: { parse_ok: false, parse_error: 'Ollama không trả về nội dung văn bản hợp lệ.', raw_response: result } }];\n}\n\nlet parsed;\ntry {\n  let clean = raw.trim();\n  clean = clean.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '').trim();\n  const start = clean.indexOf('{');\n  const end = clean.lastIndexOf('}');\n  if (start < 0 || end <= start) throw new Error('Không tìm thấy đối tượng JSON trong phản hồi AI.');\n  parsed = JSON.parse(clean.slice(start, end + 1));\n} catch (error) {\n  return [{ json: { parse_ok: false, parse_error: error.message, raw_response: raw } }];\n}\n\nreturn [{ json: { ...parsed, parse_ok: true } }];"
      },
      "type": "n8n-nodes-base.code",
