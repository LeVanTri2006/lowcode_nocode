    {
      "parameters": {
        "jsCode": "function extractList(response, keys) {\n  let value = response?.data ?? response?.body ?? response;\n  if (value && !Array.isArray(value) && typeof value === 'object') {\n    for (const key of keys) {\n      if (Array.isArray(value[key])) return value[key];\n    }\n    if (value.data && typeof value.data === 'object') {\n      for (const key of keys) {\n        if (Array.isArray(value.data[key])) return value.data[key];\n      }\n    }\n    return [];\n  }\n  return Array.isArray(value) ? value : [];\n}\n\nconst opportunitiesResponse = $('03 - Get Opportunities').first().json;\nconst risksResponse = $('04 - Get Risks').first().json;\nconst trendsResponse = $('05 - Get Market Trends').first().json;\n\nconst opportunities = extractList(opportunitiesResponse, ['opportunities', 'items', 'results']);\nconst risks = extractList(risksResponse, ['risks', 'items', 'results']);\nconst trends = extractList(trendsResponse, ['trends', 'market_trends', 'items', 'results']);\n\nconst hasInputData = opportunities.length > 0 || risks.length > 0 || trends.length > 0;\nconst analyzedAt = new Date().toISOString();\n\nconst prompt = `Bạn là chuyên gia phân tích chiến lược cạnh tranh.\nHãy xây dựng một chiến lược cạnh tranh tổng thể bằng tiếng Việt dựa trên dữ liệu thực tế bên dưới.\n\nQUY TẮC:\n- Chỉ sử dụng bằng chứng có trong dữ liệu đầu vào; không tự bịa số liệu, doanh nghiệp hoặc sự kiện.\n- Kết hợp cơ hội, rủi ro và xu hướng thành một chiến lược thống nhất.\n- Nếu dữ liệu của một nhóm bị thiếu, hãy nêu rõ hạn chế đó trong mục tiêu hoặc kết quả kỳ vọng.\n- Các bước hành động phải cụ thể, có thứ tự ưu tiên và khả thi.\n- Chỉ trả về một JSON hợp lệ, không dùng Markdown hoặc khối code.\n- action_steps phải là mảng gồm ít nhất 3 bước.\n- expected_outcome phải mô tả kết quả kỳ vọng, không khẳng định kết quả chắc chắn xảy ra.\n\nCẤU TRÚC JSON BẮT BUỘC:\n{\n  \"strategy_title\": \"Tên chiến lược\",\n  \"objective\": \"Mục tiêu chiến lược\",\n  \"action_steps\": [\"Bước 1\", \"Bước 2\", \"Bước 3\"],\n  \"expected_outcome\": \"Kết quả kỳ vọng\",\n  \"supporting_evidence\": [\"Bằng chứng từ dữ liệu\"],\n  \"limitations\": [\"Hạn chế của dữ liệu nếu có\"]\n}\n\nDỮ LIỆU CƠ HỘI (${opportunities.length} bản ghi):\n${JSON.stringify(opportunities.slice(0, 30))}\n\nDỮ LIỆU RỦI RO (${risks.length} bản ghi):\n${JSON.stringify(risks.slice(0, 30))}\n\nDỮ LIỆU XU HƯỚNG (${trends.length} bản ghi):\n${JSON.stringify(trends.slice(0, 30))}\n\nThời điểm phân tích: ${analyzedAt}`;\n\nreturn [{\n  json: {\n    analyzed_at: analyzedAt,\n    opportunities,\n    risks,\n    trends,\n    opportunity_count: opportunities.length,\n    risk_count: risks.length,\n    trend_count: trends.length,\n    has_input_data: hasInputData,\n    prompt\n  }\n}];"
      },
